# SoundStage Live — environment variables
#
# Copy this file to `.env.local` and fill in real values. Never commit real
# secrets. Values below are placeholders only.
#
# =============================================================================
# REQUIRED — the app will not function correctly without these.
# =============================================================================

# Supabase project URL (public; used by browser + server clients).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (public; browser client, RLS-enforced).
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service-role key (SECRET; server-only, bypasses RLS). Never expose
# to the browser. Used by privileged server routes and background helpers.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI API key (SECRET; powers all /api/ai/* transcription + generation).
OPENAI_API_KEY=sk-...

# Stripe secret key (SECRET; server-side checkout, subscriptions, portal).
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret (SECRET; verifies /api/stripe/webhook events).
STRIPE_WEBHOOK_SECRET=whsec_...

# =============================================================================
# OPTIONAL — Stripe price ID overrides.
# The code ships with documented test-mode price IDs as fallbacks (see
# lib/stripe/prices.ts), so these are only needed to point at different
# (e.g. live-mode) prices without a code change. Set all four together.
# =============================================================================

STRIPE_PRICE_CREATOR_MONTH=price_...
STRIPE_PRICE_CREATOR_YEAR=price_...
STRIPE_PRICE_STUDIO_MONTH=price_...
STRIPE_PRICE_STUDIO_YEAR=price_...

# =============================================================================
# OPTIONAL — everything below has a safe default or degrades gracefully.
# =============================================================================

# Public site URL used for absolute links (metadata, invite emails).
# Falls back to the production Vercel URL if unset.
NEXT_PUBLIC_SITE_URL=https://your-app.example.com

# App URL used for Stripe checkout/portal return URLs.
# Falls back to the production Vercel URL if unset.
NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Comma-separated user IDs force-granted the Studio plan (manual overrides).
STUDIO_USER_IDS=

# Shared token guarding the admin MP3-finalize maintenance endpoint.
ADMIN_MAINTENANCE_TOKEN=

# Resend API key (SECRET; enables transactional/invite email sending).
# If unset, email sending is skipped.
RESEND_API_KEY=re_...

# From-address for outbound email. Falls back to a built-in default if unset.
EMAIL_FROM=SoundStage Live <noreply@example.com>
